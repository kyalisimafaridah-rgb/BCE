PORT=3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server-side ONLY. Never in the browser, never in git, never in the UI config.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Public key used by the browser to log in.
SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Comma-separated exact origins, or empty for same-origin only. '*' is rejected at startup.
CORS_ORIGIN=